[Unit]
Description=Antigravity ACP Local HTTP Gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/upwork-buddy
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=AGY_GATEWAY_HOST=127.0.0.1
Environment=AGY_GATEWAY_PORT=11435
EnvironmentFile=-/var/www/upwork-buddy/.env
EnvironmentFile=-%h/.config/upwork-buddy/env
ExecStart=/var/www/upwork-buddy/dist/agy-gateway
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
