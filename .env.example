# Application Configuration
APP_HOST=127.0.0.1
APP_PORT=9090
APP_ENV=local
# Leave as * (or empty) to allow chrome-extension://*, moz-extension://*, and loopback HTTP origins only (never emits *).
# Or specify comma-separated origins (e.g. http://localhost:3000,http://127.0.0.1:*).
CORS_ALLOWED_ORIGINS=*
TEMPLATES_PATH=templates.yaml
SELECTORS_PATH=configs/selectors/upwork.yaml

# Daemon Auth, Policy & MCP Configuration
# Leave empty to auto-generate and persist a 32-byte random token at ~/.config/upwork-buddy/token (0600).
BUDDY_API_TOKEN=
# BUDDY_TOKEN_PATH=
MCP_ENABLED=true
POLICY_MODE=confirm_in_ui

# PostgreSQL Database Configuration
# Use 5443 for docker-compose app_db, or 5432 for local Postgres
APP_DB_HOST=localhost
APP_DB_PORT=5443
APP_DB_USERNAME=postgres
APP_DB_PASSWORD=password
APP_DB_DATABASE=upwork_buddy

# Isolated Test Database (for go test -race ./...)
# TEST_DATABASE_URL=postgres://verify_user:verify_pass@127.0.0.1:5444/upwork_buddy_verify?sslmode=disable

# LLM Provider Configuration (auto | agy | ollama)
# In auto mode, AGY is chosen when AGY_ENDPOINT_URL is non-empty, else falls back to Ollama Cloud when OLLAMA_API_KEY is set.
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=180

# AGY Gateway Configuration (local Antigravity ACP -> Ollama-compatible HTTP bridge)
# AGY_ENDPOINT_URL=http://127.0.0.1:11435
# AGY_API_KEY=
# AGY_TOKEN_PATH=~/.config/upwork-buddy/agy-gateway-token
AGY_MODEL=gemini-pro-orchestrator-neon
AGY_EFFORT=medium

# Ollama Cloud Configuration
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# Batch AI Enrichment Defaults & Guardrails
# Max jobs allowed per POST /api/jobs/enrich batch request (clamped 1..100).
ENRICHMENT_MAX_BATCH_SIZE=25
# Default enrichment mode when omitted by caller (full | ai_only | detail_only).
ENRICHMENT_DEFAULT_MODE=full
# Default force flag (false skips jobs already marked ai_enrichment_status=completed to save tokens).
ENRICHMENT_DEFAULT_FORCE=false
# Skip Chrome DOM detail scrape in full mode when last_enriched_at is already populated.
ENRICHMENT_SKIP_DETAIL_IF_PRESENT=true
# Require Chrome DOM detail scrape in full mode (false falls back to stored job text if Chrome is disconnected).
ENRICHMENT_REQUIRE_DETAILS=false
# Max concurrent LLM analysis workers per batch (clamped 1..4).
ENRICHMENT_MAX_CONCURRENCY=2
# Optional batch-only model override (empty inherits AGY_MODEL / OLLAMA_MODEL).
ENRICHMENT_DEFAULT_MODEL=
# Optional batch-only AGY effort override (empty inherits AGY_EFFORT; low | medium | high | xhigh).
ENRICHMENT_DEFAULT_EFFORT=
# UI bulk enrichment confirmation prompt threshold (clamped 0..100; 0 = always confirm).
ENRICHMENT_CONFIRM_THRESHOLD=5
# Default max wait seconds when API/MCP callers pass wait=true (clamped 5..180).
ENRICHMENT_WAIT_TIMEOUT_SECONDS=60

# Standalone Local Web Dashboard (/dashboard/)
# Enable or disable the embedded Go-served web dashboard at /dashboard/.
WEB_UI_ENABLED=true
# TTL in minutes for single-use ticket-exchanged web dashboard sessions (clamped 5..10080; default 720 = 12h).
WEB_SESSION_TTL_MINUTES=720

# Autonomous Job Watchers & Notifications
# Set WATCHER_ENABLED=false to disable the background watcher scheduler on server startup.
WATCHER_ENABLED=true
# Path to upwork-scraper-fs repo and optional Python/uv binary override.
SCRAPER_FS_DIR=/var/www/upwork-scraper-fs
# SCRAPER_FS_PYTHON_BIN=
SCRAPER_FS_TIMEOUT_SECONDS=120
# Optional fallback notification channels (can also be configured in DB via /api/notifications/config).
# WATCHER_WEBHOOK_URL=
# WATCHER_WEBHOOK_SECRET=
# WATCHER_TELEGRAM_BOT_TOKEN=
# WATCHER_TELEGRAM_CHAT_ID=

# Optional: External Database Configuration (for production/remote connections)
# EXTERNAL_DB_HOST=your-external-host.com
# EXTERNAL_DB_PORT=5432
# EXTERNAL_DB_USERNAME=your-username
# EXTERNAL_DB_PASSWORD=your-password
# EXTERNAL_DB_DATABASE=upwork_buddy_prod

# Optional: SSH Port Forwarding Configuration
# Used to connect to a database in a private network via a bastion/jump host.
# SSH_REMOTE_HOST=your-bastion-host.com
# SSH_REMOTE_PORT=22
# SSH_REMOTE_USER=your-ssh-user
# SSH_PRIVATE_KEY_PATH=/home/user/.ssh/id_rsa
# SSH_LOCAL_PORT=54321
