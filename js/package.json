{
  "name": "upwork-buddy-bookmarklet",
  "version": "1.0.0",
  "description": "TypeScript-based Upwork job analysis bookmarklet",
  "main": "dist/content.js",
  "scripts": {
    "build": "node ./scripts/build-extension.mjs",
    "build:dev": "node ./scripts/build-extension.mjs --dev",
    "watch": "node ./scripts/build-extension.mjs --dev --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "upwork",
    "bookmarklet",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.8",
    "jsdom": "^29.0.2",
    "typescript": "^5.3.2",
    "vitest": "^4.1.3"
  }
}
