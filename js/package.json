{
  "name": "upwork-buddy-extension",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MV3 Chrome & Firefox extension for Upwork job analysis, selector automation, and MCP bridge",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:web": "vite build --config vite.web.config.ts",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "upwork",
    "chrome-extension",
    "mv3",
    "wxt",
    "mcp",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@tanstack/table-core": "^8.21.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@webext-core/fake-browser": "^2.0.1",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  }
}
