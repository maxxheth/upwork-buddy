{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "types": ["chrome", "node", "vitest/globals"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "./.wxt/wxt.d.ts",
    "wxt.config.ts",
    "vitest.config.ts",
    "vite.web.config.ts",
    "entrypoints/**/*",
    "src/**/*",
    "web/**/*"
  ],
  "exclude": ["node_modules", ".output", "dist", "e2e", "playwright.config.ts"]
}
